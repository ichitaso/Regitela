    "Couldn't consume a sandbox extension for:\n%@\n\nCheck the Log tab for the reason.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر استهلاك امتداد sandbox لـ:\n%@\n\nراجع علامة تبويب السجل لمعرفة السبب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für folgenden Pfad konnte keine Sandbox-Erweiterung bezogen werden:\n%@\n\nDen Grund findest du im Tab „Protokoll“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't consume a sandbox extension for:\n%@\n\nCheck the Log tab for the reason."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo obtener una extensión de sandbox para:\n%@\n\nConsulta el motivo en la pestaña Registro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'obtenir une extension sandbox pour :\n%@\n\nConsultez l'onglet Journal pour connaître la raison."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menggunakan ekstensi sandbox untuk:\n%@\n\nPeriksa tab Log untuk mengetahui alasannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile acquisire un'estensione sandbox per:\n%@\n\nControlla la scheda Registro per il motivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のパスのサンドボックス拡張を取得できませんでした:\n%@\n\n理由はログタブで確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 경로의 샌드박스 확장을 획득하지 못했습니다:\n%@\n\n이유는 로그 탭에서 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan geen sandbox-extensie verkrijgen voor:\n%@\n\nBekijk het tabblad Logboek voor de reden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível obter uma extensão de sandbox para:\n%@\n\nVeja o motivo na aba Registro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось получить расширение песочницы для:\n%@\n\nПричину смотрите на вкладке «Журнал»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถรับส่วนขยาย sandbox สำหรับ:\n%@\n\nดูสาเหตุได้ที่แถบบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şunun için sandbox uzantısı alınamadı:\n%@\n\nNedeni için Günlük sekmesine bakın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể nhận sandbox extension cho:\n%@\n\nXem lý do trong tab Nhật ký."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取以下路径的沙盒扩展：\n%@\n\n请在“日志”标签页查看原因。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法取得以下路徑的沙盒延伸：\n%@\n\n請在「日誌」標籤頁查看原因。"
          }
        }
      }
    },
