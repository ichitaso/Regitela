          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm Màn hình luôn bật vào Cài đặt > Màn hình & Độ sáng. Khởi động lại để áp dụng. Trên màn hình không thể giảm xuống tần số quét thấp, tính năng này tốn pin hơn nhiều và có thể gây lưu ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
