        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่ม \"แตะเพื่อปลุก\" ใน การตั้งค่า > การช่วยการเข้าถึง > การสัมผัส รีบูตเพื่อให้มีผล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar > Erişilebilirlik > Dokunma bölümüne \"Uyandırmak için Dokun\"u ekler. Uygulamak için yeniden başlatın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm \"Chạm để bật\" vào Cài đặt > Trợ năng > Cảm ứng. Khởi động lại để áp dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”>“辅助功能”>“触控”中添加“轻点唤醒”。重启后生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「設定」>「輔助使用」>「觸控」中加入「點一下來喚醒」。重新開機後生效。"
          }
        }
      }
    },
    "Adds the charge limit option to Settings > Battery > Charging by adding a key to the MobileGestalt cache. Reboot to apply. Whether charging actually stops at the limit depends on the device. Disable removes only the key this app added.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف مفتاحًا إلى ذاكرة MobileGestalt المؤقتة لإظهار خيار حد الشحن في الإعدادات > البطارية > الشحن. أعد التشغيل للتطبيق. يعتمد توقف الشحن فعليًا عند الحد على الجهاز. يزيل التعطيل المفتاح الذي أضافه هذا التطبيق فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt dem MobileGestalt-Cache einen Schlüssel hinzu, damit die Option für das Ladelimit unter Einstellungen > Batterie > Laden erscheint. Zum Anwenden neu starten. Ob das Laden tatsächlich am Limit stoppt, hängt vom Gerät ab. Deaktivieren entfernt nur den Schlüssel, den diese App hinzugefügt hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds the charge limit option to Settings > Battery > Charging by adding a key to the MobileGestalt cache. Reboot to apply. Whether charging actually stops at the limit depends on the device. Disable removes only the key this app added."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una clave a la caché de MobileGestalt para que aparezca la opción de límite de carga en Ajustes > Batería > Carga. Reinicia para aplicarlo. Que la carga se detenga realmente en el límite depende del dispositivo. Desactivar solo elimina la clave que añadió esta app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute une clé au cache MobileGestalt pour afficher l'option de limite de charge dans Réglages > Batterie > Recharge. Redémarrez pour appliquer. L'arrêt effectif de la charge à la limite dépend de l'appareil. Désactiver ne supprime que la clé ajoutée par cette app."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menambahkan kunci ke cache MobileGestalt agar opsi batas pengisian muncul di Pengaturan > Baterai > Pengisian. Mulai ulang untuk menerapkan. Apakah pengisian benar-benar berhenti di batas bergantung pada perangkat. Menonaktifkan hanya menghapus kunci yang ditambahkan aplikasi ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge una chiave alla cache di MobileGestalt per mostrare l'opzione del limite di carica in Impostazioni > Batteria > Ricarica. Riavvia per applicare. Che la ricarica si fermi davvero al limite dipende dal dispositivo. Disattiva rimuove solo la chiave aggiunta da questa app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MobileGestalt キャッシュにキーを追加して、設定 > バッテリー > 充電 に充電上限の項目を出します。再起動すると反映されます。実際に上限で充電が止まるかは機種によります。無効にすると、このアプリが追加したキーだけを削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MobileGestalt 캐시에 키를 추가해 설정 > 배터리 > 충전에 충전 한도 항목이 나타나게 합니다. 재시동하면 적용됩니다. 실제로 한도에서 충전이 멈추는지는 기기에 따라 다릅니다. 끄면 이 앱이 추가한 키만 삭제합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voegt een sleutel toe aan de MobileGestalt-cache zodat de optie voor de laadlimiet verschijnt in Instellingen > Batterij > Opladen. Herstart om toe te passen. Of het opladen echt bij de limiet stopt, hangt af van het apparaat. Uitschakelen verwijdert alleen de sleutel die deze app heeft toegevoegd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona uma chave ao cache do MobileGestalt para mostrar a opção de limite de carga em Ajustes > Bateria > Carregamento. Reinicie para aplicar. Se o carregamento realmente para no limite depende do dispositivo. Desativar remove apenas a chave adicionada por este app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет ключ в кэш MobileGestalt, чтобы в Настройки > Аккумулятор > Зарядка появился параметр предела зарядки. Перезагрузите устройство, чтобы применить. Остановится ли зарядка на пределе, зависит от устройства. Выключение удаляет только ключ, добавленный этим приложением."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มคีย์ในแคช MobileGestalt เพื่อให้ตัวเลือกขีดจำกัดการชาร์จแสดงใน การตั้งค่า > แบตเตอรี่ > การชาร์จ รีบูตเพื่อให้มีผล การชาร์จจะหยุดที่ขีดจำกัดจริงหรือไม่ขึ้นอยู่กับอุปกรณ์ การปิดจะลบเฉพาะคีย์ที่แอปนี้เพิ่มไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar > Pil > Şarj bölümünde şarj sınırı seçeneğinin görünmesi için MobileGestalt önbelleğine bir anahtar ekler. Uygulamak için yeniden başlatın. Şarjın sınırda gerçekten durup durmadığı cihaza bağlıdır. Devre dışı bırakmak yalnızca bu uygulamanın eklediği anahtarı kaldırır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm một khóa vào bộ nhớ đệm MobileGestalt để tùy chọn giới hạn sạc xuất hiện trong Cài đặt > Pin > Sạc. Khởi động lại để áp dụng. Việc sạc có thực sự dừng ở giới hạn hay không tùy thuộc vào thiết bị. Tắt chỉ xóa khóa do ứng dụng này thêm vào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向 MobileGestalt 缓存添加一个键，使“设置”>“电池”>“充电”中出现充电上限选项。重启后生效。充电是否真的会在上限处停止取决于设备。停用只会删除本应用添加的键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 MobileGestalt 快取中加入一個鍵，讓「設定」>「電池」>「充電」出現充電上限選項。重新開機後生效。充電是否真的會在上限處停止取決於裝置。停用只會刪除本 App 加入的鍵。"
          }
        }
      }
    },
    "Adds the charge limit option to Settings > Battery > Charging. Reboot to apply. Whether charging actually stops at the limit depends on the device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
