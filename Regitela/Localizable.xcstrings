          "stringUnit": {
            "state": "translated",
            "value": "Diatur ke Mati. Keluar dari app Pengaturan untuk menerapkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato. Chiudi l'app Impostazioni per applicare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにしました。設定アプリを終了すると反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "껐습니다. 설정 앱을 종료하면 적용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgeschakeld. Sluit de Instellingen-app af om toe te passen."
          }
        },
