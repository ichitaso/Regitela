        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tắt. Thoát ứng dụng Cài đặt để áp dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已关闭。退出“设置”应用后生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已關閉。結束「設定」App 後生效。"
          }
        }
      }
    },
