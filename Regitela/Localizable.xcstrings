    "Shows what the app is doing and why something failed. Long-press the text to copy it, and tap Clear to empty it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض ما يفعله التطبيق وسبب فشل أي عملية. اضغط مطولاً على النص لنسخه، واضغط على «مسح» لإفراغه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt, was die App gerade tut und warum etwas fehlgeschlagen ist. Text lange drücken zum Kopieren, auf „Löschen“ tippen zum Leeren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows what the app is doing and why something failed. Long-press the text to copy it, and tap Clear to empty it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra lo que hace la app y por qué algo falló. Mantén pulsado el texto para copiarlo y toca Borrar para vaciarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche ce que fait l'app et la raison d'un échec. Touchez longuement le texte pour le copier, et touchez Effacer pour le vider."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan apa yang sedang dilakukan app dan mengapa sesuatu gagal. Tekan lama teks untuk menyalinnya, dan ketuk Hapus untuk mengosongkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra cosa sta facendo l'app e perché qualcosa non è riuscito. Tieni premuto sul testo per copiarlo e tocca Cancella per svuotarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの動作や、失敗した理由を表示します。テキストを長押しするとコピーでき、「消去」で空にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱의 동작과 실패 원인을 표시합니다. 텍스트를 길게 눌러 복사하고, '지우기'로 비울 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont wat de app doet en waarom iets is mislukt. Houd de tekst ingedrukt om die te kopiëren en tik op Wis om het logboek te legen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o que o app está fazendo e por que algo falhou. Toque e segure o texto para copiá-lo e toque em Limpar para esvaziá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает, что делает приложение и почему что-то не удалось. Удерживайте текст, чтобы скопировать его, и нажмите «Очистить», чтобы очистить журнал."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงสิ่งที่แอปกำลังทำและสาเหตุที่การทำงานล้มเหลว กดค้างที่ข้อความเพื่อคัดลอก และแตะล้างเพื่อล้างข้อมูล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın ne yaptığını ve bir şeyin neden başarısız olduğunu gösterir. Kopyalamak için metne uzun basın, boşaltmak için Temizle'ye dokunun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị hoạt động của ứng dụng và lý do khi có lỗi. Nhấn giữ văn bản để sao chép, chạm Xóa để làm trống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示应用的运行情况和失败原因。长按文本可拷贝，点按“清除”可清空。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示 App 的執行情況與失敗原因。長按文字可拷貝，點一下「清除」可清空。"
          }
        }
      }
    },
